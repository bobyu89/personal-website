---
/** 課程卡上的小插圖，咖啡色線條＋一點顏色。 */
interface Props {
  name: "book" | "tool" | "bird" | "team";
  size?: string;
}
const { name, size = "3.2rem" } = Astro.props;
---

<svg viewBox="0 0 64 64" style={`width:${size};height:${size}`} aria-hidden="true" fill="none" stroke="#4a3424" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
  {
    name === "book" && (
      <>
        <path d="M8 16 C18 12 26 13 32 19 C38 13 46 12 56 16 V48 C46 44 38 45 32 51 C26 45 18 44 8 48 Z" fill="#fbf4e2" />
        <path d="M32 19 V51" />
        <path d="M14 24 h11 M14 31 h10 M39 24 h11 M39 31 h9" stroke="#c8a873" />
        <path d="M44 6 C40 12 42 18 48 18 C50 12 48 8 44 6 Z" fill="#e8b53d" stroke="#b98418" />
      </>
    )
  }
  {
    name === "tool" && (
      <>
        <rect x="8" y="12" width="48" height="36" rx="5" fill="#fbf4e2" />
        <path d="M8 20 H56" />
        <circle cx="13" cy="16" r="1" fill="#4a3424" />
        <circle cx="18" cy="16" r="1" fill="#4a3424" />
        <path d="M20 30 l-5 5 l5 5 M44 30 l5 5 l-5 5 M35 27 l-6 16" stroke="#b4552d" />
        <path d="M24 54 h16 M32 48 v6" />
      </>
    )
  }
  {
    name === "bird" && (
      <>
        <path d="M10 38 C16 22 38 20 46 32 C38 44 18 46 10 38 Z" fill="#3f6b4d" stroke="#2d5240" />
        <path d="M26 30 C30 14 44 10 50 14 C46 24 36 30 26 30 Z" fill="#2d5240" stroke="#2d5240" />
        <path d="M46 32 L56 30 L47 37 Z" fill="#d8932c" stroke="#a66d1c" />
        <circle cx="40" cy="30" r="1.6" fill="#fbf4e2" stroke="none" />
        <path d="M6 50 q6 -4 12 0 t12 0 t12 0 t12 0" stroke="#c8a873" />
      </>
    )
  }
  {
    name === "team" && (
      <>
        <circle cx="32" cy="20" r="8" fill="#e8b53d" stroke="#b98418" />
        <circle cx="14" cy="38" r="6" fill="#c4643a" stroke="#8f4322" />
        <circle cx="50" cy="38" r="6" fill="#7a9654" stroke="#4f6c36" />
        <circle cx="32" cy="50" r="6" fill="#dc9d3f" stroke="#a66d1c" />
        <path d="M26 25 L18 33 M38 25 L46 33 M32 28 V44 M20 40 L26 47 M44 40 L38 47" stroke-dasharray="2 4" />
      </>
    )
  }
</svg>
