---
/** 一片銀杏葉。tone 決定顏色，size 決定寬度。 */
interface Props {
  tone?: "ginkgo" | "rust" | "moss" | "amber";
  size?: string;
  class?: string;
  rotate?: number;
}
const { tone = "ginkgo", size = "2.5rem", class: cls = "", rotate = 0 } = Astro.props;
const fill = { ginkgo: "#dcab45", rust: "#b4602f", moss: "#6f8a52", amber: "#c98f35" }[tone];
const edge = { ginkgo: "#a5772b", rust: "#7f3d1f", moss: "#4a6236", amber: "#93621f" }[tone];
---

<svg
  class={`leaf ${cls}`}
  viewBox="0 0 100 100"
  width={size}
  style={`width:${size};height:auto;transform:rotate(${rotate}deg)`}
  aria-hidden="true"
>
  <g filter="url(#paint-soft)">
  <path d="M50 96 C51 86 50 74 50 62" stroke={edge} stroke-width="3.2" fill="none" stroke-linecap="round"></path>
  <path
    d="M50 64 C33 63 10 50 5 25 C20 9 38 8 46 17 L50 30 L54 17 C62 8 80 9 95 25 C90 50 67 63 50 64 Z"
    fill={fill}
    stroke={edge}
    stroke-width="2.4"
    stroke-linejoin="round"></path>
  <g stroke={edge} stroke-width="1.1" opacity=".45" fill="none">
    <path d="M50 62 L22 24"></path><path d="M50 62 L34 18"></path><path d="M50 62 L44 22"></path>
    <path d="M50 62 L78 24"></path><path d="M50 62 L66 18"></path><path d="M50 62 L56 22"></path>
  </g>
  </g>
</svg>
