---
/**
 * 森林住民：熊（森林的主人，愛讀書）、兔子（引路員）、狗（送信員）。全部是原創 SVG。
 * 畫法：穿著毛衣、褲子的小動物，黑豆眼、低彩度、細咖啡色線；外層套 #paint 手繪濾鏡（在 PaintDefs.astro）。
 * 這個元件輸出 <g>，只能放在 <svg> 裡面。座標原點在身體中央，腳底大約在 y = 60。
 */
interface Props {
  kind: "bear" | "rabbit" | "dog";
  x?: number;
  y?: number;
  scale?: number;
  flip?: boolean;
  prop?: "book" | "leaf" | "letter" | "laptop" | "none";
  /** 小尺寸時用較輕的濾鏡 */
  soft?: boolean;
  class?: string;
}
const { kind, x = 0, y = 0, scale = 1, flip = false, prop = "none", soft = false, class: cls = "" } = Astro.props;
const t = `translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`;
const ink = "#3b2a1e";
const paw = { bear: "#7b5236", rabbit: "#ebe3d3", dog: "#c48f58" }[kind];
---

<g transform={t} class={`critter ${kind} ${cls}`}>
  <ellipse cx="0" cy="61" rx="34" ry="5.5" fill="#6b5326" opacity=".22"></ellipse>
  <g filter={soft ? "url(#paint-soft)" : "url(#paint)"} stroke={ink} stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
    {
      kind === "bear" && (
        <g>
          <path d="M-35 58 C-37 44 -18 40 0 46 C18 40 37 44 35 58 C20 63 -20 63 -35 58 Z" fill="#3f3229" />
          <ellipse cx="-32" cy="55" rx="7.5" ry="6" fill="#7b5236" />
          <ellipse cx="32" cy="55" rx="7.5" ry="6" fill="#7b5236" />
          <path d="M-25 47 C-31 24 -25 4 0 2 C25 4 31 24 25 47 Z" fill="#56704a" />
          <path d="M-25 47 C-29 30 -26 14 -16 6 C-20 20 -19 36 -14 47 Z" fill="#445a3b" stroke="none" />
          <path d="M-22 43 H22 M-16 43 v4 M-10 43 v4 M-4 43 v4 M2 43 v4 M8 43 v4 M14 43 v4" stroke="#445a3b" />
          <path d="M-9 8 l3 6 l3 -6 l3 6 l3 -6 l3 6" stroke="#7d9468" fill="none" />
          <ellipse cx="-25" cy="27" rx="7" ry="14" transform="rotate(14 -25 27)" fill="#56704a" />
          <ellipse cx="25" cy="27" rx="7" ry="14" transform="rotate(-14 25 27)" fill="#56704a" />
          <ellipse cx="0" cy="4" rx="12" ry="4" fill="#445a3b" />
          <circle cx="-19" cy="-38" r="8" fill="#7b5236" />
          <circle cx="19" cy="-38" r="8" fill="#7b5236" />
          <circle cx="-19" cy="-38" r="3.8" fill="#c9a77e" stroke="none" />
          <circle cx="19" cy="-38" r="3.8" fill="#c9a77e" stroke="none" />
          <ellipse cx="0" cy="-20" rx="25" ry="22" fill="#7b5236" />
          <path d="M-22 -14 C-18 -2 -8 2 0 2 C-10 -2 -18 -8 -22 -14 Z" fill="#64412a" stroke="none" />
          <ellipse cx="0" cy="-12" rx="10" ry="7.5" fill="#e7d3ad" />
          <ellipse cx="0" cy="-15" rx="3.6" ry="2.6" fill={ink} stroke="none" />
          <path d="M0 -12.5 v2.6 M-3.2 -9.2 q3.2 2.2 6.4 0" fill="none" stroke-width="1.2" />
          <circle class="eye" cx="-9" cy="-22" r="2.5" fill={ink} stroke="none" />
          <circle class="eye" cx="9" cy="-22" r="2.5" fill={ink} stroke="none" />
          <path d="M-5 -41 l1.5 3 M1 -42 l.8 3.2 M6 -40.5 l-.6 3" stroke="#5b3b25" />
        </g>
      )
    }
    {
      kind === "rabbit" && (
        <g>
          <circle cx="19" cy="36" r="6" fill="#ebe3d3" />
          <rect x="-15" y="36" width="12" height="22" rx="5" fill="#34504a" />
          <rect x="3" y="36" width="12" height="22" rx="5" fill="#34504a" />
          <ellipse cx="-10" cy="59" rx="8" ry="3.8" fill="#ebe3d3" />
          <ellipse cx="10" cy="59" rx="8" ry="3.8" fill="#ebe3d3" />
          <path d="M-20 42 C-23 20 -16 4 0 2 C16 4 23 20 20 42 C8 45 -8 45 -20 42 Z" fill="#c9963a" />
          <path d="M-20 42 C-22 28 -19 14 -12 6 C-14 20 -13 32 -9 44 Z" fill="#a97a2a" stroke="none" />
          <path d="M1 6 V43" fill="none" stroke="#a97a2a" />
          <circle cx="4" cy="15" r="1.5" fill={ink} stroke="none" />
          <circle cx="4" cy="24" r="1.5" fill={ink} stroke="none" />
          <circle cx="4" cy="33" r="1.5" fill={ink} stroke="none" />
          <ellipse cx="21" cy="20" rx="5.5" ry="12" transform="rotate(-12 21 20)" fill="#c9963a" />
          <ellipse cx="-20" cy="16" rx="5.5" ry="11" transform="rotate(30 -20 16)" fill="#c9963a" />
          <path d="M-9 -26 C-14 -52 -10 -66 -4 -64 C1 -62 0 -44 -3 -27 Z" fill="#ebe3d3" />
          <path d="M-7.5 -30 C-10 -48 -8 -58 -5 -57 C-3 -55 -3 -44 -4.5 -31 Z" fill="#d8b4a0" stroke="none" />
          <path d="M4 -27 C8 -50 18 -60 22 -56 C25 -50 16 -38 10 -26 Z" fill="#ebe3d3" />
          <path d="M7 -30 C10 -46 16 -53 19 -51 C20 -47 14 -38 10 -30 Z" fill="#d8b4a0" stroke="none" />
          <circle cx="0" cy="-13" r="17" fill="#ebe3d3" />
          <path d="M-16 -8 C-12 2 -4 4 2 4 C-6 0 -12 -4 -16 -8 Z" fill="#d6cbb6" stroke="none" />
          <circle class="eye" cx="-6.5" cy="-15" r="2.2" fill={ink} stroke="none" />
          <circle class="eye" cx="6.5" cy="-15" r="2.2" fill={ink} stroke="none" />
          <path d="M-1.8 -9 h3.6 l-1.8 2.2 Z" fill="#a5776a" stroke="none" />
          <path d="M0 -6.8 v1.8 M-2.6 -4.4 q2.6 1.8 5.2 0" fill="none" stroke-width="1.1" />
          <ellipse cx="0" cy="3" rx="9" ry="3" fill="#a97a2a" />
        </g>
      )
    }
    {
      kind === "dog" && (
        <g>
          <path class="tail" d="M20 40 C34 36 38 22 33 14 C30 22 26 30 18 34 Z" fill="#c48f58" />
          <path d="M-24 58 C-28 30 -20 6 0 4 C20 6 28 30 24 58 Z" fill="#c48f58" />
          <path d="M-15 26 H15 V58 H-15 Z" fill="#4b3a2e" />
          <path d="M-13 26 L-17 8 M13 26 L17 8" stroke="#4b3a2e" stroke-width="3.4" />
          <rect x="-7" y="32" width="14" height="9" rx="1.5" fill="#5c4838" />
          <circle cx="-11" cy="29" r="1.4" fill="#d9b25a" stroke="none" />
          <circle cx="11" cy="29" r="1.4" fill="#d9b25a" stroke="none" />
          <ellipse cx="-14" cy="58" rx="10" ry="4.6" fill="#c48f58" />
          <ellipse cx="14" cy="58" rx="10" ry="4.6" fill="#c48f58" />
          <ellipse cx="-24" cy="30" rx="6" ry="13" transform="rotate(16 -24 30)" fill="#c48f58" />
          <ellipse cx="24" cy="30" rx="6" ry="13" transform="rotate(-16 24 30)" fill="#c48f58" />
          <path d="M-18 4 C-6 12 6 12 18 4 L18 10 C6 18 -6 18 -18 10 Z" fill="#a9512e" />
          <path d="M8 12 L14 28 L6 27 L3 13 Z" fill="#8f4322" />
          <ellipse cx="0" cy="-16" rx="22" ry="20" fill="#c48f58" />
          <path d="M-20 -8 C-16 2 -6 4 0 4 C-10 0 -16 -4 -20 -8 Z" fill="#a8743f" stroke="none" />
          <path d="M-15 -32 C-30 -31 -33 -10 -25 -1 C-19 -7 -16 -19 -11 -28 Z" fill="#6e4a2e" />
          <path d="M15 -32 C30 -31 33 -10 25 -1 C19 -7 16 -19 11 -28 Z" fill="#6e4a2e" />
          <path d="M-4 -34 C-3 -26 3 -26 4 -34" fill="#efdfc0" stroke="none" />
          <ellipse cx="0" cy="-7" rx="10" ry="7.5" fill="#efdfc0" />
          <ellipse cx="0" cy="-10.5" rx="3.8" ry="2.8" fill={ink} stroke="none" />
          <path d="M0 -7.6 v2.4 M-3.4 -4.2 q3.4 2.4 6.8 0" fill="none" stroke-width="1.2" />
          <circle class="eye" cx="-8" cy="-19" r="2.5" fill={ink} stroke="none" />
          <circle class="eye" cx="8" cy="-19" r="2.5" fill={ink} stroke="none" />
        </g>
      )
    }

    {
      prop === "book" && (
        <g transform="translate(0 24)">
          <path d="M-28 -6 C-15 -11 -4 -9 0 -4 C4 -9 15 -11 28 -6 L28 14 C15 9 4 11 0 16 C-4 11 -15 9 -28 14 Z" fill="#efe4cc" />
          <path d="M0 -4 V16" />
          <path d="M-22 0 h14 M-22 5 h12 M8 0 h14 M8 5 h10" stroke="#b9a27a" stroke-width="1.2" />
          <ellipse cx="-28" cy="5" rx="6" ry="5.5" fill={paw} />
          <ellipse cx="28" cy="5" rx="6" ry="5.5" fill={paw} />
        </g>
      )
    }
    {
      prop === "leaf" && (
        <g class="umbrella">
          <path d="M-24 22 C-27 -4 -28 -32 -30 -60" fill="none" stroke="#9a7428" stroke-width="2.6" />
          <path d="M-30 -58 C-48 -58 -70 -70 -74 -94 C-60 -110 -42 -110 -34 -100 L-30 -88 L-26 -100 C-18 -110 0 -110 14 -94 C10 -70 -12 -58 -30 -58 Z" fill="#d9a63f" />
          <path d="M-30 -60 L-58 -96 M-30 -60 L-44 -102 M-30 -60 L-16 -102 M-30 -60 L-2 -96" stroke="#b5862c" stroke-width="1" fill="none" />
          <ellipse cx="-24" cy="22" rx="5.5" ry="5" fill={paw} />
        </g>
      )
    }
    {
      prop === "letter" && (
        <g transform="translate(0 24) rotate(-8)">
          <rect x="-19" y="-12" width="38" height="25" rx="2" fill="#efe4cc" />
          <path d="M-19 -12 L0 3 L19 -12" fill="none" />
          <circle cx="0" cy="4" r="4" fill="#a9512e" />
          <ellipse cx="-19" cy="5" rx="5.5" ry="5" fill={paw} />
          <ellipse cx="19" cy="5" rx="5.5" ry="5" fill={paw} />
        </g>
      )
    }
    {
      prop === "laptop" && (
        <g transform="translate(0 28)">
          <path d="M-25 -16 H25 V9 H-25 Z" fill="#4a3a2c" />
          <path d="M-21 -12 H21 V5 H-21 Z" fill="#9fb59a" />
          <path d="M-13 -6 l-4 4 l4 4 M13 -6 l4 4 l-4 4 M3 -8 l-5 12" stroke="#34504a" fill="none" />
          <path d="M-31 9 H31 L27 15 H-27 Z" fill="#6f5a44" />
          <ellipse cx="-23" cy="13" rx="5.5" ry="5" fill={paw} />
          <ellipse cx="23" cy="13" rx="5.5" ry="5" fill={paw} />
        </g>
      )
    }
  </g>
</g>
