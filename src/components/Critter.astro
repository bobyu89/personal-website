---
/**
 * 森林住民：熊（森林的主人，愛讀書）、兔子（引路員）、狗（送信員）。全部是原創 SVG。
 * 這個元件輸出 <g>，只能放在 <svg> 裡面。座標原點在身體中央，腳底大約在 y = 60。
 */
interface Props {
  kind: "bear" | "rabbit" | "dog";
  x?: number;
  y?: number;
  scale?: number;
  flip?: boolean;
  prop?: "book" | "leaf" | "letter" | "laptop" | "none";
  class?: string;
}
const { kind, x = 0, y = 0, scale = 1, flip = false, prop = "none", class: cls = "" } = Astro.props;
const t = `translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`;
---

<g transform={t} class={`critter ${kind} ${cls}`}>
  <ellipse cx="0" cy="62" rx="40" ry="7" fill="#7d5c2c" opacity=".28"></ellipse>
  {
    kind === "bear" && (
      <g>
        <ellipse cx="0" cy="26" rx="35" ry="35" fill="#8a5a36" />
        <ellipse cx="0" cy="32" rx="21" ry="23" fill="#c9965f" />
        <ellipse cx="-19" cy="54" rx="14" ry="9" fill="#7a4d2d" />
        <ellipse cx="19" cy="54" rx="14" ry="9" fill="#7a4d2d" />
        <ellipse cx="-19" cy="55" rx="7" ry="4.5" fill="#e6c79a" />
        <ellipse cx="19" cy="55" rx="7" ry="4.5" fill="#e6c79a" />
        <circle cx="-23" cy="-44" r="11" fill="#8a5a36" />
        <circle cx="23" cy="-44" r="11" fill="#8a5a36" />
        <circle cx="-23" cy="-44" r="5.5" fill="#c9965f" />
        <circle cx="23" cy="-44" r="5.5" fill="#c9965f" />
        <circle cx="0" cy="-20" r="29" fill="#8a5a36" />
        <ellipse cx="0" cy="-10" rx="13" ry="10" fill="#e6c79a" />
        <ellipse cx="0" cy="-15" rx="5.5" ry="4" fill="#3a2516" />
        <path d="M0 -11 v4 M-5 -6 q5 4 10 0" stroke="#3a2516" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <circle class="eye" cx="-11" cy="-25" r="3.4" fill="#2a1c12" />
        <circle class="eye" cx="11" cy="-25" r="3.4" fill="#2a1c12" />
        <circle cx="-18" cy="-13" r="5" fill="#e2876a" opacity=".45" />
        <circle cx="18" cy="-13" r="5" fill="#e2876a" opacity=".45" />
        <path d="M-27 4 C-10 13 10 13 27 4 L27 12 C10 21 -10 21 -27 12 Z" fill="#e8b53d" />
        <path d="M12 14 L20 36 L10 36 L6 16 Z" fill="#c98f22" />
      </g>
    )
  }
  {
    kind === "rabbit" && (
      <g>
        <g class="ears">
          <ellipse cx="-10" cy="-54" rx="8" ry="24" transform="rotate(-8 -10 -54)" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
          <ellipse cx="-10" cy="-52" rx="3.5" ry="16" transform="rotate(-8 -10 -52)" fill="#eab0a0" />
          <path d="M6 -34 C10 -60 26 -72 30 -62 C33 -54 22 -40 14 -32 Z" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
          <path d="M12 -38 C16 -54 24 -62 26 -58 C27 -52 20 -44 15 -38 Z" fill="#eab0a0" />
        </g>
        <ellipse cx="0" cy="30" rx="27" ry="31" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
        <circle cx="26" cy="46" r="8" fill="#fffaf1" stroke="#c9b48f" stroke-width="2" />
        <ellipse cx="-13" cy="58" rx="12" ry="6.5" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
        <ellipse cx="13" cy="58" rx="12" ry="6.5" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
        <circle cx="0" cy="-14" r="23" fill="#f4ece0" stroke="#c9b48f" stroke-width="2" />
        <circle class="eye" cx="-9" cy="-17" r="3.2" fill="#2a1c12" />
        <circle class="eye" cx="9" cy="-17" r="3.2" fill="#2a1c12" />
        <path d="M-3 -9 L3 -9 L0 -5 Z" fill="#d98a7a" />
        <path d="M0 -5 v3 M-4 0 q4 3 8 0" stroke="#8a6a55" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <path d="M-6 -6 h-14 M-6 -3 l-13 3 M6 -6 h14 M6 -3 l13 3" stroke="#c9b48f" stroke-width="1.2" />
        <circle cx="-15" cy="-8" r="4" fill="#eab0a0" opacity=".6" />
        <circle cx="15" cy="-8" r="4" fill="#eab0a0" opacity=".6" />
        <path d="M-22 10 C-8 18 8 18 22 10 L24 18 C8 26 -8 26 -24 18 Z" fill="#3f6b4d" />
      </g>
    )
  }
  {
    kind === "dog" && (
      <g>
        <path class="tail" d="M24 34 C40 30 46 14 40 4 C36 14 30 22 20 26 Z" fill="#c98b4a" />
        <ellipse cx="0" cy="28" rx="29" ry="32" fill="#c98b4a" />
        <ellipse cx="0" cy="34" rx="17" ry="22" fill="#f2dfbd" />
        <ellipse cx="-15" cy="56" rx="12" ry="7" fill="#f2dfbd" />
        <ellipse cx="15" cy="56" rx="12" ry="7" fill="#f2dfbd" />
        <circle cx="0" cy="-16" r="25" fill="#c98b4a" />
        <path d="M-20 -32 C-36 -30 -40 -6 -30 6 C-24 0 -20 -14 -16 -26 Z" fill="#7a4f2e" />
        <path d="M20 -32 C36 -30 40 -6 30 6 C24 0 20 -14 16 -26 Z" fill="#7a4f2e" />
        <ellipse cx="0" cy="-5" rx="14" ry="11" fill="#f2dfbd" />
        <path d="M-6 -30 C-4 -38 4 -38 6 -30 C4 -26 -4 -26 -6 -30 Z" fill="#f2dfbd" />
        <ellipse cx="0" cy="-10" rx="5.5" ry="4" fill="#3a2516" />
        <path d="M0 -6 v3 M-6 -2 q6 4 12 0" stroke="#3a2516" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <path d="M-3 0 q3 7 6 0 Z" fill="#e0786a" />
        <circle class="eye" cx="-10" cy="-20" r="3.4" fill="#2a1c12" />
        <circle class="eye" cx="10" cy="-20" r="3.4" fill="#2a1c12" />
        <path d="M-22 6 C-8 13 8 13 22 6 L22 12 C8 19 -8 19 -22 12 Z" fill="#b4552d" />
        <circle cx="0" cy="17" r="4" fill="#e8b53d" stroke="#b98418" stroke-width="1.5" />
      </g>
    )
  }

  {
    prop === "book" && (
      <g transform="translate(0 30)">
        <path d="M-30 -6 C-16 -12 -4 -10 0 -4 C4 -10 16 -12 30 -6 L30 16 C16 10 4 12 0 18 C-4 12 -16 10 -30 16 Z" fill="#fbf5e6" stroke="#7a5233" stroke-width="2" />
        <path d="M0 -4 V18" stroke="#7a5233" stroke-width="1.6" />
        <path d="M-24 0 h16 M-24 6 h14 M8 0 h16 M8 6 h12" stroke="#c8a873" stroke-width="1.6" />
        <ellipse cx="-30" cy="6" rx="7" ry="6" fill={kind === "bear" ? "#7a4d2d" : "#c98b4a"} />
        <ellipse cx="30" cy="6" rx="7" ry="6" fill={kind === "bear" ? "#7a4d2d" : "#c98b4a"} />
      </g>
    )
  }
  {
    prop === "leaf" && (
      <g class="umbrella">
        <path d="M-20 24 C-24 0 -26 -30 -30 -60" stroke="#b98418" stroke-width="3" fill="none" stroke-linecap="round" />
        <path d="M-30 -58 C-48 -58 -70 -70 -74 -94 C-60 -110 -42 -110 -34 -100 L-30 -88 L-26 -100 C-18 -110 0 -110 14 -94 C10 -70 -12 -58 -30 -58 Z" fill="#e8b53d" stroke="#b98418" stroke-width="2.4" stroke-linejoin="round" />
        <ellipse cx="-20" cy="24" rx="7" ry="6" fill={kind === "rabbit" ? "#f4ece0" : "#c98b4a"} stroke={kind === "rabbit" ? "#c9b48f" : "none"} stroke-width="2" />
      </g>
    )
  }
  {
    prop === "letter" && (
      <g transform="translate(0 24) rotate(-8)">
        <rect x="-20" y="-12" width="40" height="27" rx="3" fill="#fbf5e6" stroke="#7a5233" stroke-width="2" />
        <path d="M-20 -12 L0 4 L20 -12" stroke="#7a5233" stroke-width="2" fill="none" />
        <circle cx="0" cy="5" r="4.5" fill="#b4552d" />
        <ellipse cx="-20" cy="6" rx="6.5" ry="6" fill="#f2dfbd" />
        <ellipse cx="20" cy="6" rx="6.5" ry="6" fill="#f2dfbd" />
      </g>
    )
  }
  {
    prop === "laptop" && (
      <g transform="translate(0 28)">
        <path d="M-26 -16 H26 V10 H-26 Z" fill="#4a3424" />
        <path d="M-22 -12 H22 V6 H-22 Z" fill="#9fc3a8" />
        <path d="M-14 -6 l-4 4 l4 4 M14 -6 l4 4 l-4 4 M3 -8 l-5 12" stroke="#2d5240" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <path d="M-32 10 H32 L28 16 H-28 Z" fill="#6f5440" />
        <ellipse cx="-24" cy="14" rx="6.5" ry="5.5" fill="#f2dfbd" />
        <ellipse cx="24" cy="14" rx="6.5" ry="5.5" fill="#f2dfbd" />
      </g>
    )
  }
</g>
