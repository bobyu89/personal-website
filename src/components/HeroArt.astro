---
/**
 * 首頁主視覺：Bob 用 AI 繪圖生成的銀杏樹與三位森林住民（public/img/forest/hero.webp）。
 * 弧形標語與路標上的字用網頁文字疊上去（AI 寫的字常出錯，也方便日後修改）。
 */
import Pic from "./Pic.astro";
import { site } from "../data/site";
---

<div class="hero-art">
  <svg class="arc" viewBox="0 0 600 120" aria-hidden="true">
    <path id="arc" d="M 30 116 Q 300 -24 570 116" fill="none"></path>
    <text font-size="27"><textPath href="#arc" startOffset="50%" text-anchor="middle">{site.motto}</textPath></text>
  </svg>
  <div class="stage">
    <Pic
      name="hero"
      eager
      alt="一棵金黃的銀杏大樹下，穿綠毛衣的熊靠著樹幹讀書；穿芥末黃開襟衫的兔子撐著一片銀杏葉，站在路標旁；圍紅圍巾、穿吊帶褲的小狗拿著信跑過來；天上有兩隻綠色小鳥，銀杏葉在空中飄"
    />
    <span class="sign s1" aria-hidden="true">課程 →</span>
    <span class="sign s2" aria-hidden="true">← 工具</span>
  </div>
</div>

<style>
  .hero-art {
    position: relative;
  }
  .arc {
    display: block;
    width: 92%;
    margin: 0 auto -4%;
    overflow: visible;
  }
  .arc text {
    font-family: var(--sans);
    fill: #9a5a32;
    letter-spacing: 0.12em;
  }
  .stage {
    position: relative;
    container-type: inline-size;
  }
  .sign {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 2.15cqw;
    color: #5a3a22;
    text-shadow: 0 0 3px #f3dcae, 0 0 6px #f3dcae;
    white-space: nowrap;
    pointer-events: none;
  }
  .s1 {
    left: 80.6%;
    top: 61.9%;
  }
  .s2 {
    left: 79.4%;
    top: 69.6%;
  }
</style>
