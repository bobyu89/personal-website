---
/** 單獨一隻（或三隻一起）的森林住民，輸出完整的 <svg>。 */
import Critter from "./Critter.astro";

interface Props {
  kind: "bear" | "rabbit" | "dog" | "team";
  prop?: "book" | "leaf" | "letter" | "laptop" | "none";
  size?: string;
  label?: string;
  class?: string;
}
const { kind, prop = "none", size = "6rem", label, class: cls = "" } = Astro.props;
const box = kind === "team" ? "-120 -80 240 150" : prop === "leaf" ? "-80 -115 140 185" : "-50 -80 100 150";
---

<svg
  class={`animal ${cls}`}
  viewBox={box}
  style={`width:${size};height:auto`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    kind === "team" ? (
      <>
        <Critter kind="rabbit" x={-78} y={10} scale={0.78} />
        <Critter kind="dog" x={78} y={10} scale={0.8} flip />
        <Critter kind="bear" x={0} y={0} scale={0.95} />
      </>
    ) : (
      <Critter kind={kind} prop={prop} />
    )
  }
</svg>
