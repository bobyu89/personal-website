---
import { contact, modes } from "../data/profile";
import Arrow from "./Arrow.astro";

const mailto = contact.email
  ? `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`
  : "#contact";
---

<nav class="nav" aria-label="主選單">
  <a class="nav__mark" href="#top" aria-label="回到頂端">
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="3.2" fill="var(--research)" />
      <circle cx="21" cy="11" r="3.2" fill="var(--clinical)" />
      <circle cx="11" cy="21" r="3.2" fill="var(--tech)" />
      <circle cx="21" cy="21" r="3.2" fill="var(--creative)" />
    </svg>
  </a>
  <ul class="nav__links">
    {
      modes.map((mode) => (
        <li>
          <a href={`#${mode.id}`} data-mode={mode.id}>
            {mode.zh}
          </a>
        </li>
      ))
    }
  </ul>
  <a class="btn nav__action" href={mailto}>合作<Arrow /></a>
</nav>

<style>
  .nav {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(12 14 20 / 0.55);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 12px 40px -12px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    transform: translateX(-50%);
    max-width: calc(100vw - 24px);
  }

  .nav__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .nav__mark svg {
    width: 30px;
    height: 30px;
    transition: transform 0.6s var(--ease-out);
  }

  .nav__mark:hover svg {
    transform: rotate(90deg);
  }

  .nav__links {
    display: flex;
    gap: 2px;
  }

  .nav__links a {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav__links a:hover,
  .nav__links a[aria-current="true"] {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  .nav__links a[aria-current="true"] {
    color: var(--accent);
  }

  .nav__action {
    min-height: 40px;
    padding-inline: 18px 16px;
    font-size: 15px;
  }

  @media (max-width: 560px) {
    .nav__links a {
      padding: 0 10px;
      font-size: 14px;
    }

    .nav__action {
      display: none;
    }
  }
</style>

<script>
  // 目前捲到哪個章節，就把那個連結點亮
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav__links a"));
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((s): s is HTMLElement => Boolean(s));
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            if (link.hash === `#${entry.target.id}`) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
