---
import Leaf from "./Leaf.astro";
import { site } from "../data/site";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { id: "new", label: "新課程", href: `${base}#new` },
  { id: "open", label: "開過的課", href: `${base}#open` },
  { id: "tools", label: "工具與 Skill", href: `${base}#tools` },
  { id: "about", label: "關於", href: `${base}#about` },
];
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href={base} aria-label={`${site.name}，回首頁`}>
      <Leaf size="2rem" rotate={-18} />
      <span>{site.name}</span>
    </a>
    <nav aria-label="主要">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--kraft) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 2px dashed var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    padding-block: 0.55rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.98rem;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    background: var(--paper);
    color: var(--rust-deep);
  }
  @media (max-width: 34rem) {
    nav a {
      padding: 0.15rem 0.5rem;
      font-size: 0.92rem;
    }
  }
</style>
