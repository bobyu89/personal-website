---
import { intro, modes, site } from "../data/profile";

const tabs = [{ id: "all", zh: "整合", en: "Integrated" }, ...modes];
const codeLines = intro.tech.split("\n");
---

<header class="hero" id="top" data-field="ink" data-chapter>
  <div class="hero__inner wrap grid">
    <div class="hero__tabs" role="tablist" aria-label="切換介紹模式">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            class="hero__tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-mode={tab.id}
          >
            <span class="hero__swatch" data-swatch={tab.id} aria-hidden="true" />
            <span class="hero__tab-zh">{tab.zh}</span>
            <span class="hero__tab-en" lang="en">
              {tab.en}
            </span>
          </button>
        ))
      }
    </div>

    <div class="hero__panels">
      <div class="hero__panel is-active" role="tabpanel" id="panel-all" aria-labelledby="tab-all" tabindex="0" data-panel="all">
        <p class="statement">{intro.all}</p>
      </div>

      <div class="hero__panel" role="tabpanel" id="panel-research" aria-labelledby="tab-research" tabindex="0" data-panel="research" hidden>
        <dl class="abstract">
          {
            intro.research.map((row) => (
              <div class="abstract__row">
                <dt>{row.label}</dt>
                <dd>{row.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero__panel" role="tabpanel" id="panel-clinical" aria-labelledby="tab-clinical" tabindex="0" data-panel="clinical" hidden>
        <p class="statement">{intro.clinical.text}</p>
        <p class="small hero__cite">
          <a href={intro.clinical.citeHref} rel="noopener">{intro.clinical.cite}</a>
        </p>
      </div>

      <div class="hero__panel" role="tabpanel" id="panel-tech" aria-labelledby="tab-tech" tabindex="0" data-panel="tech" hidden>
        <pre class="code"><code>{codeLines.map((line) => <span class:list={["code__line", { "code__line--comment": line.trim().startsWith("//") }]}>{line}{"\n"}</span>)}</code></pre>
      </div>

      <div class="hero__panel" role="tabpanel" id="panel-creative" aria-labelledby="tab-creative" tabindex="0" data-panel="creative" hidden>
        <p class="statement">{intro.creative}</p>
      </div>
    </div>

    <h1 class="monument">{site.name}</h1>
  </div>
</header>

<style>
  .hero {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--nav-h));
    overflow: hidden;
    view-transition-name: hero;
  }

  .hero__inner {
    flex: 1;
    grid-template-rows: auto auto 1fr;
    row-gap: clamp(28px, 4vh, 48px);
    padding-top: clamp(28px, 7vh, 96px);
  }

  /* Tabs */
  .hero__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .hero__tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 14px 8px 10px;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }

  .hero__tab:hover {
    background: color-mix(in oklab, var(--fg) 12%, var(--bg));
  }

  .hero__tab[aria-selected="true"] {
    background: var(--fg);
    color: var(--bg);
  }

  .hero__tab:focus-visible {
    outline-offset: 2px;
  }

  .hero__swatch {
    flex: none;
    width: 22px;
    height: 22px;
    background: var(--swatch);
  }

  .hero__swatch[data-swatch="research"] { --swatch: var(--research); }
  .hero__swatch[data-swatch="clinical"] { --swatch: var(--clinical); }
  .hero__swatch[data-swatch="tech"] { --swatch: var(--tech); }
  .hero__swatch[data-swatch="creative"] { --swatch: var(--creative); }
  .hero__swatch[data-swatch="all"] {
    background: conic-gradient(
      var(--clinical) 0 25%,
      var(--tech) 0 50%,
      var(--creative) 0 75%,
      var(--research) 0
    );
  }

  /* 和底色相同的色塊，加一圈前景色讓它不會消失 */
  .hero[data-field="research"] .hero__swatch[data-swatch="research"],
  .hero[data-field="clinical"] .hero__swatch[data-swatch="clinical"],
  .hero[data-field="tech"] .hero__swatch[data-swatch="tech"],
  .hero[data-field="creative"] .hero__swatch[data-swatch="creative"] {
    box-shadow: inset 0 0 0 2px var(--bg), 0 0 0 2px var(--bg);
  }

  .hero__tab-en {
    font-weight: 400;
    font-size: var(--size-small);
  }

  :global(html:not(.js)) .hero__tabs {
    display: none;
  }

  /* Panels：疊在同一格，切換時版面不跳動 */
  .hero__panels {
    display: grid;
    align-items: start;
  }

  .hero__panel {
    grid-area: 1 / 1;
  }

  :global(.js) .hero__panel:not(.is-active) {
    visibility: hidden;
  }

  .hero__panel:focus-visible {
    outline-offset: 8px;
  }

  .hero__panel .statement {
    max-width: 22em;
  }

  .hero__cite {
    margin-top: 1.1em;
  }

  .abstract {
    display: grid;
    gap: 0.5em;
    font-size: calc(var(--size-statement) * 0.86);
    line-height: 1.45;
    font-weight: 700;
  }

  .abstract__row {
    display: grid;
    grid-template-columns: 3.4em 1fr;
    gap: 0.6em;
  }

  .abstract dt {
    font-weight: 900;
  }

  .code {
    font-size: clamp(13px, 0.62rem + 0.62vw, 19px);
    line-height: 1.65;
    font-weight: 500;
    white-space: pre;
    overflow-x: auto;
    tab-size: 2;
  }

  .code__line--comment {
    color: color-mix(in oklab, var(--fg) 72%, var(--bg));
  }

  /* Monument */
  .monument {
    align-self: end;
    font-size: var(--size-monument-fit);
    font-weight: 800;
    line-height: 0.74;
    letter-spacing: -0.055em;
    margin-left: -0.055em;
    padding-bottom: 0.035em;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-rows: auto 1fr;
    }

    .hero__tabs {
      grid-column: 9 / -1;
      grid-row: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .hero__tab {
      justify-content: flex-start;
      gap: 14px;
      min-height: 56px;
      padding-inline: 14px 18px;
      font-size: 22px;
    }

    .hero__tab-en {
      margin-left: auto;
    }

    .hero__panels {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .monument {
      grid-row: 2;
    }
  }

  @media (max-width: 640px) {
    /* 手機上不撐滿整個螢幕，避免狀態句與名字之間出現大片空白 */
    .hero {
      min-height: 0;
    }

    .hero__inner {
      row-gap: 32px;
      padding-top: 24px;
    }

    .monument {
      margin-top: 40px;
    }

    .hero__tabs {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
      margin-inline: -4px;
    }

    .hero__tab {
      flex-direction: column;
      gap: 6px;
      padding: 10px 4px;
    }

    .hero__tab-en {
      display: none;
    }

    :global(html:not(.js)) .hero__tabs {
      display: none;
    }
  }
</style>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  ::view-transition-old(hero),
  ::view-transition-new(hero) {
    animation: none;
    mix-blend-mode: normal;
    height: 100%;
    overflow: clip;
  }

  ::view-transition-group(hero) {
    animation-duration: 0s;
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hero__tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".hero__panel"));
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  // JS 接手後改用「疊放＋隱藏」切換，避免面板高度不同造成跳動
  for (const panel of panels) panel.hidden = false;

  const apply = (mode: string) => {
    if (!hero) return;
    hero.dataset.field = mode === "all" ? "ink" : mode;
    for (const tab of tabs) {
      const on = tab.dataset.mode === mode;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
    }
    for (const panel of panels) {
      const on = panel.dataset.panel === mode;
      panel.classList.toggle("is-active", on);
      panel.inert = !on;
    }
    document.dispatchEvent(new Event("fieldchange"));
  };

  const select = (tab: HTMLButtonElement) => {
    const mode = tab.dataset.mode ?? "all";
    if (!hero || tab.getAttribute("aria-selected") === "true") return;
    if (!document.startViewTransition || reduce.matches) {
      apply(mode);
      return;
    }
    // 招牌動作：新模式的顏色從被按下的色塊擴散開來，填滿整個首屏
    const box = hero.getBoundingClientRect();
    const swatch = tab.querySelector(".hero__swatch")?.getBoundingClientRect() ?? tab.getBoundingClientRect();
    const x = swatch.left + swatch.width / 2 - box.left;
    const y = swatch.top + swatch.height / 2 - box.top;
    const r = Math.hypot(Math.max(x, box.width - x), Math.max(y, box.height - y));
    const transition = document.startViewTransition(() => apply(mode));
    transition.ready.then(() => {
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 760, easing: "cubic-bezier(0.16, 1, 0.3, 1)", pseudoElement: "::view-transition-new(hero)" },
      );
    });
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (event) => {
      const keys: Record<string, number> = {
        ArrowRight: i + 1,
        ArrowDown: i + 1,
        ArrowLeft: i - 1,
        ArrowUp: i - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(event.key in keys)) return;
      event.preventDefault();
      const next = tabs[(keys[event.key] + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });

  for (const panel of panels) panel.inert = !panel.classList.contains("is-active");
</script>
