---
import Base from "../layouts/Base.astro";
import HeroArt from "../components/HeroArt.astro";
import Leaf from "../components/Leaf.astro";
import Animal from "../components/Animal.astro";
import { about, cast, contact, openCourses, paths, tools } from "../data/site";
import { courses } from "../data/courses";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (h: string) => (/^https?:/.test(h) ? h : base + h);
const ext = (h: string) => /^https?:/.test(h);
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subject)}`;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Welcome to the Learning Forest</p>
        <h1>歡迎來到，<br /><span class="hl">Bob 的學習森林</span>。</h1>
        <p class="lede">
          給護理人的 AI 課、研究筆記課、文獻工具和 Claude Skills，都種在這片森林裡。不用一次走完，一次撿一片葉子就好。
        </p>
        <p class="actions">
          <a class="btn btn-primary" href="#new">看四門新課</a>
          <a class="btn btn-quiet" href="#start">不知道從哪開始？</a>
        </p>
        <ul class="counts" aria-label="森林裡有什麼">
          <li><b>{courses.length}</b>門新課</li>
          <li><b>{openCourses.length}</b>門開過的課</li>
          <li><b>{tools.length}</b>個工具與 Skill</li>
        </ul>
      </div>
      <div class="hero-pic">
        <HeroArt />
      </div>
    </div>
  </section>

  <!-- 四門新課：目錄式清單 -->
  <section class="section" id="new">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Chapter 1 · New Paths</p>
        <h2>森林地圖：四門新課</h2>
        <p>正在準備的四門課，大綱先公開。每一門都用護理與研究的真實情境來教，課裡用到的工具，森林裡都找得到。</p>
      </div>
      <ol class="toc">
        {
          courses.map((c, i) => (
            <li class="reveal" style={`transition-delay:${i * 80}ms`}>
              <a href={`${base}courses/${c.slug}/`}>
                <span class="no">
                  <Leaf tone={c.tone} size="3.4rem" rotate={i % 2 ? 14 : -14} />
                  <b>{c.no}</b>
                </span>
                <span class="tt">
                  <strong>{c.title}</strong>
                  <small>{c.sub}</small>
                  <span class="tag">{c.status}</span>
                </span>
                <span class="ic">
                  <Animal kind={c.guide.kind} prop={c.guide.prop} size={c.guide.kind === "team" ? "5.6rem" : "3.8rem"} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 從哪裡開始 -->
  <section class="section start" id="start">
    <div class="wrap">
      <div class="start-head reveal">
        <div class="section-head">
          <p class="eyebrow">Chapter 2 · Where to Begin</p>
          <h2>不知道從哪裡開始？</h2>
          <p>挑一句最像你的話，照著小路走。</p>
        </div>
        <div class="guide">
          <p class="bubble">跟我走，<br />我帶你去！</p>
          <Animal kind="rabbit" prop="leaf" size="7.5rem" label="引路員兔子，撐著一片銀杏葉" />
        </div>
      </div>
      <div class="paths">
        {
          paths.map((p, i) => (
            <article class="card path reveal" style={`transition-delay:${i * 80}ms`}>
              <h3>「{p.who}」</h3>
              <ol>
                {p.steps.map((s) => (
                  <li>
                    <a href={href(s.href)} rel={ext(s.href) ? "noopener" : undefined}>
                      {s.label}
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 開過的課 -->
  <section class="section" id="open">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Chapter 3 · Courses I've Taught</p>
        <h2>開過的課</h2>
        <p>已經上線的課程網站，教材、簡報、學習單都在裡面，可以自己走一遍。</p>
      </div>
      <div class="grid">
        {
          openCourses.map((c, i) => (
            <a class="card item reveal" href={c.href} rel="noopener" style={`transition-delay:${i * 60}ms`}>
              <Leaf tone={c.tone} size="2.4rem" rotate={20} class="corner" />
              <span class="tag">{c.tag}</span>
              <h3>{c.title}</h3>
              <p class="sub">{c.sub}</p>
              <p>{c.text}</p>
              <span class="go">走進去 ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 工具與 Skill -->
  <section class="section" id="tools">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Chapter 4 · Tools & Skills</p>
        <h2>工具與 Skill</h2>
        <p>為自己和同學寫的工具。重複的事交給程式，判斷留給人。</p>
      </div>
      <div class="grid tools">
        {
          tools.map((t, i) => (
            <a class="card item reveal" href={t.href} rel="noopener" style={`transition-delay:${i * 60}ms`}>
              <Leaf tone={t.tone} size="2.2rem" rotate={-24} class="corner" />
              <span class="tag">{t.tag}</span>
              <h3>{t.title}</h3>
              <p class="sub">{t.sub}</p>
              <p>{t.text}</p>
              <span class="go">{t.href.includes("github.com") ? "看原始碼 ↗" : "打開 ↗"}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 關於 -->
  <section class="section" id="about">
    <div class="wrap about card reveal">
      <Animal kind="bear" prop="book" size="8rem" class="about-pic" label="森林的主人：一隻正在讀書的熊" />
      <div>
        <p class="eyebrow">About</p>
        <h2>{about.heading}</h2>
        {about.body.map((t) => <p>{t}</p>)}
        <p class="actions">
          <a class="btn btn-primary" href={mailto}>寫信給我</a>
          <a class="btn btn-quiet" href="https://github.com/bobyu89" rel="noopener">GitHub</a>
        </p>
      </div>
    </div>

    <div class="wrap cast">
      <h2 class="cast-h reveal">森林裡住著三位</h2>
      <ul>
        {
          cast.map((c, i) => (
            <li class="card reveal" style={`transition-delay:${i * 80}ms`}>
              <Animal kind={c.kind} prop={c.prop} size="6.5rem" />
              <div>
                <h3>
                  {c.name}
                  <small>{c.role}</small>
                </h3>
                <p>{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) 1rem;
  }
  .hero-grid {
    display: grid;
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 2.5rem;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    line-height: 1.25;
  }
  .hl {
    background: linear-gradient(transparent 62%, #f3cf6399 62%);
  }
  .lede {
    font-size: 1.18rem;
    color: var(--ink-soft);
    max-width: 32rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.4rem 0;
  }
  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--ink-soft);
  }
  .counts b {
    font-family: var(--display);
    font-size: 1.6rem;
    color: var(--rust);
    margin-right: 0.25rem;
  }
  .hero-pic {
    max-width: 38rem;
    margin-inline: auto;
    width: 100%;
  }

  /* 目錄式清單 */
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 3rem;
  }
  @media (min-width: 52rem) {
    .toc {
      grid-template-columns: 1fr 1fr;
    }
  }
  .toc a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 0.6rem;
    border-bottom: 2px dashed var(--line);
    color: var(--ink);
    text-decoration: none;
    border-radius: 12px;
    transition: background 0.2s;
  }
  .toc a:hover {
    background: #fbf4e2aa;
  }
  .toc a:hover :global(.leaf) {
    animation: wiggle 0.6s ease;
  }
  @keyframes wiggle {
    30% {
      rotate: 14deg;
    }
    70% {
      rotate: -8deg;
    }
  }
  .no {
    position: relative;
    display: block;
    width: 3.4rem;
    height: 3.4rem;
  }
  .no :global(.leaf) {
    display: block;
  }
  .no b {
    position: absolute;
    inset: 27% 0 auto;
    line-height: 1;
    text-align: center;
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--ink);
  }
  .tt {
    display: grid;
    gap: 0.15rem;
  }
  .tt strong {
    font-size: 1.3rem;
    line-height: 1.35;
  }
  .tt small {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .tt .tag {
    justify-self: start;
    margin-top: 0.3rem;
  }
  @media (max-width: 30rem) {
    .ic {
      display: none;
    }
    .toc a {
      grid-template-columns: auto 1fr;
    }
  }

  /* 從哪裡開始 */
  .start {
    background: linear-gradient(transparent, #e9d4a466 20%, #e9d4a466 80%, transparent);
  }
  .paths {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 52rem) {
    .paths {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .path {
    padding: 1.4rem 1.4rem 1.2rem;
  }
  .path h3 {
    font-size: 1.2rem;
    color: var(--moss-deep);
  }
  .path ol {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .path ol::before {
    content: "";
    position: absolute;
    left: 0.85rem;
    top: 0.8rem;
    bottom: 0.8rem;
    border-left: 3px dotted var(--line);
  }
  .path li {
    counter-increment: s;
    position: relative;
    padding: 0.35rem 0 0.35rem 2.6rem;
  }
  .path li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ginkgo);
    border: 2px solid var(--ginkgo-deep);
    font-family: var(--display);
    font-size: 0.9rem;
  }

  /* 卡片格 */
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .grid.tools {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.1rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      opacity 0.7s ease,
      translate 0.7s ease;
  }
  .item:hover {
    color: var(--ink);
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: 0 16px 28px -16px #6e4a2c88;
  }
  .item :global(.corner) {
    position: absolute;
    top: -0.9rem;
    right: 1rem;
  }
  .item .tag {
    align-self: flex-start;
  }
  .item h3 {
    font-size: 1.3rem;
    margin: 0.5rem 0 0.1rem;
  }
  .item .sub {
    color: var(--rust);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }
  .item p:not(.sub) {
    color: var(--ink-soft);
    font-size: 0.98rem;
    flex: 1;
  }
  .go {
    font-weight: 700;
    color: var(--moss);
  }

  /* 關於 */
  .about {
    display: grid;
    gap: 1rem 2rem;
    align-items: center;
    padding: clamp(1.4rem, 4vw, 2.6rem);
  }
  @media (min-width: 44rem) {
    .about {
      grid-template-columns: 9rem 1fr;
    }
  }
  .about :global(.about-pic) {
    margin-inline: auto;
  }
  @media (min-width: 44rem) {
    .about {
      grid-template-columns: 10rem 1fr;
    }
  }

  /* 兔子引路 */
  .start-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0 1.5rem;
  }
  .guide {
    display: flex;
    align-items: end;
    gap: 0.2rem;
    margin-bottom: 1.2rem;
  }
  .bubble {
    position: relative;
    margin: 0 0 4.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--paper);
    border: 2px solid var(--line);
    border-radius: 16px;
    font-size: 0.98rem;
    line-height: 1.4;
  }
  .bubble::after {
    content: "";
    position: absolute;
    right: -10px;
    bottom: 12px;
    border: 8px solid transparent;
    border-left-color: var(--line);
  }

  /* 森林住民 */
  .cast {
    margin-top: 2.5rem;
  }
  .cast-h {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }
  .cast ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
  }
  @media (min-width: 52rem) {
    .cast ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cast li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.2rem;
  }
  .cast :global(.animal) {
    flex: none;
  }
  .cast h3 {
    font-size: 1.3rem;
    margin: 0 0 0.2rem;
  }
  .cast h3 small {
    margin-left: 0.5rem;
    font-size: 0.9rem;
    color: var(--rust);
  }
  .cast p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .about h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
</style>
